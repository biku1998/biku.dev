---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} article={article}>
  <div class="mx-auto max-w-2xl px-4 py-8 md:py-16">
    <Header />
    <main class="mt-12 md:mt-16">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
