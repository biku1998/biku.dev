---
import PageLayout from './PageLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../lib/utils';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  image?: string;
  headings?: Heading[];
}

const { title, description, pubDate, tags = [], image, headings = [] } = Astro.props;

// Show TOC only for longer posts (5+ headings)
const showToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 5;
---

<PageLayout title={title} description={description} image={image} article={true}>
  <article class="max-w-2xl mx-auto">
    <header class="mb-8 md:mb-12">
      <h1 class="text-headline-md mb-4">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-label-sm text-muted">
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <TagBadge tag={tag} linked />
              ))}
            </div>
          )
        }
      </div>
    </header>

    {
      image && (
        <div class="mb-8 md:mb-12 rounded-md overflow-hidden border border-border">
          <img
            src={image}
            alt=""
            class="w-full aspect-video object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    {showToc && <TableOfContents headings={headings} />}

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</PageLayout>
