---
interface Props {
  tag: string;
  size?: 'sm' | 'md';
  linked?: boolean;
}

const { tag, size = 'md', linked = false } = Astro.props;

const sizeClasses = {
  sm: 'chip-sm',
  md: 'chip-md',
};

const baseClasses = `chip ${sizeClasses[size]}`;
---

{
  linked ? (
    <a href={`/tags/${tag}`} class={`${baseClasses} transition-colors`}>
      {tag}
    </a>
  ) : (
    <span class={baseClasses}>{tag}</span>
  )
}
