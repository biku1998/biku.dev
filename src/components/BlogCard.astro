---
import TagBadge from './TagBadge.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: string;
}

const { title, description, slug, pubDate, tags = [], readingTime } = Astro.props;
---

<article class="group">
  <a
    href={`/blog/${slug}`}
    class="block p-5 rounded-md border border-border hover:border-accent hover:bg-accent-soft transition-all duration-200"
  >
    <div class="flex items-start justify-between gap-4 mb-2">
      <h3 class="text-headline-sm group-hover:text-accent transition-colors">
        {title}
      </h3>
      <span class="text-accent shrink-0 mt-1 transition-transform duration-200 group-hover:translate-x-1">
        →
      </span>
    </div>
    <p class="text-body-sm text-muted mb-3 line-clamp-2">
      {description}
    </p>
    <div class="flex flex-wrap items-center gap-3 text-label-sm text-muted">
      <time datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
      {readingTime && <span>{readingTime}</span>}
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.slice(0, 3).map((tag) => (
              <TagBadge tag={tag} size="sm" />
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>
