---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<nav class="flex items-center gap-1 mr-1">
  {
    navItems.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class:list={[
            'nav-link text-label-md',
            isActive ? 'nav-link-active' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
