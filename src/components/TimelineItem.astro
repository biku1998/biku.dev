---
interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
  current?: boolean;
  isLast?: boolean;
}

const { company, role, period, description, current = false, isLast = false } = Astro.props;
---

<div class="relative pl-6 pb-8 last:pb-0">
  <!-- Vertical line -->
  {
    !isLast && (
      <div class="absolute left-[7px] top-3 bottom-0 w-px bg-border" />
    )
  }

  <!-- Dot marker -->
  <div
    class:list={[
      'absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2',
      current
        ? 'bg-accent border-accent'
        : 'bg-background border-border',
    ]}
  />

  <!-- Content -->
  <div class="min-w-0">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
      <h3 class="font-medium text-foreground">{role}</h3>
      <span class="text-xs text-muted whitespace-nowrap">{period}</span>
    </div>
    <p class="text-sm text-accent mb-2">{company}</p>
    <p class="text-sm text-muted leading-relaxed">{description}</p>
  </div>
</div>
