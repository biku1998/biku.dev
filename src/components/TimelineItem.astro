---
interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
  highlights?: string[];
  current?: boolean;
  isLast?: boolean;
}

const { company, role, period, description, highlights = [], current = false, isLast = false } = Astro.props;
---

<div class="relative pl-6 pb-8 last:pb-0">
  <!-- Vertical line -->
  {
    !isLast && (
      <div class="absolute left-[7px] top-3 bottom-0 w-px bg-border" />
    )
  }

  <!-- Dot marker -->
  <div
    class:list={[
      'absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2',
      current
        ? 'bg-accent border-accent'
        : 'bg-background border-border',
    ]}
    style={current ? { boxShadow: '0 0 0 4px var(--color-accent-soft)' } : undefined}
  />

  <!-- Content -->
  <div class="min-w-0">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
      <h3 class="text-label-lg text-foreground flex items-center gap-2">
        {role}
        {current && <span class="chip chip-sm chip-accent">current</span>}
      </h3>
      <span class="text-label-sm text-muted whitespace-nowrap">{period}</span>
    </div>
    <p class="text-body-sm text-accent mb-2">{company}</p>
    <p class="text-body-sm text-muted leading-relaxed">{description}</p>

    {highlights.length > 0 && (
      <ul class="mt-3 space-y-2">
        {highlights.map((highlight) => (
          <li class="text-body-sm text-muted leading-relaxed flex gap-2">
            <span class="text-accent mt-1 shrink-0">•</span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
