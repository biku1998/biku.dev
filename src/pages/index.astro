---
import PageLayout from '../layouts/PageLayout.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../lib/utils';

const recentPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<PageLayout
  title="Sourabh Kumar"
  description="Full-stack product engineer and engineering leader with 6+ years building and scaling web platforms. Technical Lead at QualityKiosk, working on AI initiatives and products."
>
  <section class="space-y-6">
    <div class="flex items-center gap-4">
      <img
        src="/me.png"
        alt="Sourabh Kumar"
        class="w-16 h-16 md:w-20 md:h-20 rounded-full object-cover"
      />
      <h1 class="text-2xl md:text-3xl font-bold">👋 I'm Sourabh</h1>
    </div>

    <div class="space-y-4 text-muted leading-relaxed">
      <p>
        I'm a Product Engineer driving AI from idea to production. Currently working as Technical Lead at <a
          href="https://www.qualitykiosk.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-2"
        >QualityKiosk</a>, partnering with the CTO to shape the company's AI initiatives and products. Before this, I spent 6+ years at <a
          href="https://enqurious.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-2"
        >Enqurious</a> building and scaling learning platforms that have helped 7k+ people grow.
      </p>

      <p>
        Lately, I've been focused on applied AI in production: LLM apps and agents, workflow and automations.
      </p>

      <p>
        Outside of work, I write about engineering, product thinking, and lessons learned building software at scale. I'm a person who <a
          href="https://www.ncbi.nlm.nih.gov/books/NBK603738/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-2"
        >stammers</a>, and over the past few years I've largely overcome it by deliberately putting myself in uncomfortable situations.
      </p>
    </div>
  </section>

  <Timeline />

  {
    recentPosts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-medium mb-6">Recent Writing</h2>
        <ul class="space-y-4">
          {recentPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex justify-between items-baseline gap-4"
              >
                <span class="group-hover:text-accent transition-colors">{post.data.title}</span>
                <span class="text-sm text-muted shrink-0">
                  {formatDateShort(post.data.pubDate)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/blog"
          class="inline-block mt-6 text-sm text-accent hover:underline underline-offset-2"
        >
          View all posts →
        </a>
      </section>
    )
  }
</PageLayout>
