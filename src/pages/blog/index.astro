---
import PageLayout from '../../layouts/PageLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getReadingTime } from '../../lib/utils';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract all unique tags
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<PageLayout title="Blog" description="Thoughts on engineering, product, and building software.">
  <div class="accent-bar mb-4" />
  <p class="text-eyebrow text-accent mb-3">Writing</p>
  <h1 class="text-headline-lg mb-2">Blog</h1>
  <p class="text-body-md text-muted mb-8 max-w-xl">Thoughts on engineering, product, and building software.</p>

  {
    allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {allTags.map((tag) => (
          <TagBadge tag={tag} linked />
        ))}
      </div>
    )
  }

  <div class="space-y-3">
    {
      posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.id}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={getReadingTime(post.body)}
        />
      ))
    }
  </div>

  {
    posts.length === 0 && (
      <p class="text-body-md text-muted py-8 text-center">No posts yet. Check back soon!</p>
    )
  }
</PageLayout>
