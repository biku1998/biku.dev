---
import PageLayout from '../../layouts/PageLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getReadingTime } from '../../lib/utils';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract all unique tags
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<PageLayout title="Blog" description="Thoughts on engineering, product, and building software.">
  <h1 class="text-2xl md:text-3xl font-bold mb-2">Blog</h1>
  <p class="text-muted mb-8">Thoughts on engineering, product, and building software.</p>

  {
    allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {allTags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs px-2 py-1 rounded bg-border/50 text-muted hover:bg-border hover:text-foreground transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )
  }

  <div class="space-y-2">
    {
      posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.id}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={getReadingTime(post.body)}
        />
      ))
    }
  </div>

  {
    posts.length === 0 && (
      <p class="text-muted py-8 text-center">No posts yet. Check back soon!</p>
    )
  }
</PageLayout>
